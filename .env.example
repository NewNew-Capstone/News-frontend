# Local backend for Vite dev proxy
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# Optional direct API base URL. Leave unset during Vite dev to avoid browser CORS.
# VITE_API_BASE_URL=https://your-api-domain.com

# Optional frontend origin for social login redirect URLs
# VITE_APP_ORIGIN=http://localhost:3000
